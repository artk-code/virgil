# Copy to encinitas.env (gitignored) and fill in your own values.
#   cp encinitas.env.example encinitas.env
#
# Never commit encinitas.env — it contains secrets.

# Required: Hugging Face token with access to google/gemma-4-26B-A4B-it
# Create at https://huggingface.co/settings/tokens
# Accept the Gemma license: https://huggingface.co/google/gemma-4-26B-A4B-it
HF_TOKEN=

# Optional: Fireworks cloud inference
# FIREWORKS_API_KEY=

# Optional paths (defaults shown)
# ENCINITAS_BASE_MODEL=google/gemma-4-26B-A4B-it
# ENCINITAS_ADAPTER_HF=coldcurrent/encinitas-gemma4-lora
# ENCINITAS_ADAPTER_PATH=/absolute/path/to/encinitas-peft

# Optional: AMD ROCm / Strix Halo
# HIP_VISIBLE_DEVICES=0
# HSA_OVERRIDE_GFX_VERSION=11.5.1
# HF_DEACTIVATE_ASYNC_LOAD=1