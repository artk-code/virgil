# VIRGIL-ML gitignore

# Training outputs and checkpoints (very large)
training/outputs/
training/*.bin
training/*.safetensors
training/merged/

# WandB / experiment tracking
wandb/
*.wandb

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Large model caches (if any local downloads)
huggingface/
.cache/huggingface/

# Temporary synthesis scratch
/tmp/next_batch*.json
*.bak
*.tmp

# If future files get very large, consider Git LFS:
# *.jsonl filter=lfs diff=lfs merge=lfs -text
# But current sizes (<30MB) are fine for normal git.