# ------------------------------------------------------------------------------
# Copy to `.env` before first `docker compose up`:
#   cp .env.example .env
#
# `.env` is gitignored. Treat it like a password manager for local dev only.
# ------------------------------------------------------------------------------

# --- PostgreSQL (required for postgres service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=app

# DSN consumed by app services (host `postgres` matches compose service name)
DATABASE_URL=postgres://app:change_me_local_only@postgres:5432/app?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Security stream topology ---
SECURITY_EVENTS_STREAM=security_events
SECURITY_ANALYSIS_STREAM=security_analysis
SECURITY_ALERTS_STREAM=security_alerts
SECURITY_DLQ_STREAM=security_dlq
SECURITY_HEARTBEAT_STREAM=security_heartbeats
SECURITY_RULES_GROUP=py-rules-cg
SECURITY_TRANSFORM_GROUP=transform-cg
SECURITY_TRANSFORM_ANALYSIS_GROUP=transform-analysis-cg

# --- Agent identity / behavior ---
HOST_ID=local-dev-host
AGENT_ID=agent-simulator
SOURCE_TYPE=simulator
LOG_LEVEL=INFO
PIPELINE_RETRY_MAX=3
PIPELINE_DEDUPE_TTL_SECONDS=3600

# --- ETL ---
ETL_INTERVAL_SECONDS=60
ETL_BATCH_SIZE=200
ETL_CONSUMER_NAME=transform-etl
ETL_RUN_ONCE=false

# --- Optional tuning ---
RUST_LOG=info
PYTHONUNBUFFERED=1
