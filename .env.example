# ------------------------------------------------------------------------------
# Copy to `.env` before first `docker compose up`:
#   cp .env.example .env
#
# `.env` is gitignored. Treat it like a password manager for local dev only.
# ------------------------------------------------------------------------------

# --- PostgreSQL (required for postgres service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=app

# DSN consumed by app services (host `postgres` matches compose service name)
DATABASE_URL=postgres://app:change_me_local_only@postgres:5432/app?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Optional tuning ---
RUST_LOG=info
PYTHONUNBUFFERED=1
